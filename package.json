{
  "name": "pi-durable",
  "version": "0.1.0",
  "description": "General-purpose interactive coding harness on Pi Durable. pi opens the harness, pi-agent keeps the upstream Pi CLI.",
  "type": "module",
  "bin": {
    "pi": "./bin/pi",
    "pi-agent": "./bin/pi-agent"
  },
  "files": ["*.ts", "bin/", "README.md"],
  "scripts": {
    "start": "bun main.ts",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/chord": "1.1.0",
    "typebox": "1.3.27",
    "pi-web-search": "1.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
